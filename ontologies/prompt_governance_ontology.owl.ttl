@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <https://example.org/prompt-guard#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix linkml: <https://w3id.org/linkml/> .
ex:Character a owl:Class , linkml:ClassDefinition ;
	rdfs:label "Character" ;
	rdfs:subClassOf ex:NarrativeEntity , _:c14n13 , _:c14n23 , _:c14n3 ;
	skos:definition "An actor or person within the narrative universe." ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:Creature a owl:Class , linkml:ClassDefinition ;
	rdfs:label "Creature" ;
	rdfs:subClassOf ex:NarrativeEntity , _:c14n1 , _:c14n16 , _:c14n21 ;
	skos:definition "A non-human living, acting subject -- an animal or personified creature. Added after auditing 88 real captions from storage/antelora/mccay: ~10% (a horse, a bird, a fish, a crab, two monkeys, a turkey, a reindeer) named a living subject that was neither a Character (\"an actor or person\") nor a Prop nor a Setting. Disjoint from Character/ Setting/Prop via NarrativeEntity's children_are_mutually_disjoint." ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:NarrativeEntity a owl:Class , linkml:ClassDefinition ;
	rdfs:label "NarrativeEntity" ;
	rdfs:subClassOf _:c14n18 , _:c14n25 ;
	skos:definition "Base class for all persistent story world elements." ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:PromptSpecification a owl:Class , linkml:ClassDefinition ;
	rdfs:label "PromptSpecification" ;
	rdfs:subClassOf _:c14n20 , _:c14n4 , _:c14n6 , _:c14n7 ;
	skos:definition "The top-level structured prompt payload validated by the matrix layer before generation." ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:Prop a owl:Class , linkml:ClassDefinition ;
	rdfs:label "Prop" ;
	rdfs:subClassOf ex:NarrativeEntity , _:c14n2 ;
	skos:definition "Key physical objects or items. carried_by is optional, not required -- a Prop may be carried by a Character, or stand alone as the scene's own focal subject (a lamp, a cigar, a sign) with no carrier at all. Absence of carried_by does not mean an object fails to fit this class." ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:Setting a owl:Class , linkml:ClassDefinition ;
	rdfs:label "Setting" ;
	rdfs:subClassOf ex:NarrativeEntity , _:c14n15 , _:c14n5 ;
	skos:definition "A location or environmental backdrop." ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:VisualAttribute a owl:Class , linkml:ClassDefinition ;
	rdfs:label "VisualAttribute" ;
	rdfs:subClassOf _:c14n19 , _:c14n8 , _:c14n9 ;
	skos:definition "Governs aesthetic texture, lighting, and style tokens." ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:VisualComposition a owl:Class , linkml:ClassDefinition ;
	rdfs:label "VisualComposition" ;
	rdfs:subClassOf _:c14n0 , _:c14n22 , _:c14n24 ;
	skos:definition "Governs camera framing, perspective, and spatial layout." ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:camera_angle a owl:ObjectProperty , linkml:SlotDefinition ;
	rdfs:label "camera_angle" ;
	rdfs:range linkml:String ;
	skos:definition "E.g., EyeLevel, LowAngle, BirdEye" ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:canonical_outfit a owl:ObjectProperty , linkml:SlotDefinition ;
	rdfs:label "canonical_outfit" ;
	rdfs:range linkml:String ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:carried_by a owl:ObjectProperty , linkml:SlotDefinition ;
	rdfs:label "carried_by" ;
	rdfs:range ex:Character ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:color_palette a owl:ObjectProperty , linkml:SlotDefinition ;
	rdfs:label "color_palette" ;
	rdfs:range linkml:String ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:current_location a owl:ObjectProperty , linkml:SlotDefinition ;
	rdfs:label "current_location" ;
	rdfs:range ex:Setting ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:current_state a owl:ObjectProperty , linkml:SlotDefinition ;
	rdfs:label "current_state" ;
	rdfs:range linkml:String ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:description a owl:ObjectProperty , linkml:SlotDefinition ;
	rdfs:label "description" ;
	rdfs:range linkml:String ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:entity_name a owl:ObjectProperty , linkml:SlotDefinition ;
	rdfs:label "entity_name" ;
	rdfs:range linkml:String ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:environmental_conditions a owl:ObjectProperty , linkml:SlotDefinition ;
	rdfs:label "environmental_conditions" ;
	rdfs:range linkml:String ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:focal_subject a owl:ObjectProperty , linkml:SlotDefinition ;
	rdfs:label "focal_subject" ;
	rdfs:range ex:NarrativeEntity ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:lighting_style a owl:ObjectProperty , linkml:SlotDefinition ;
	rdfs:label "lighting_style" ;
	rdfs:range linkml:String ;
	skos:definition "E.g., CinematicStudio, Chiaroscuro, NaturalDaylight" ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:lora_activator a owl:ObjectProperty , linkml:SlotDefinition ;
	rdfs:label "lora_activator" ;
	rdfs:range linkml:String ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:narrative_elements a owl:ObjectProperty , linkml:SlotDefinition ;
	rdfs:label "narrative_elements" ;
	rdfs:range ex:NarrativeEntity ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:prompt_id a owl:ObjectProperty , linkml:SlotDefinition ;
	rdfs:label "prompt_id" ;
	rdfs:range linkml:String ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:shot_type a owl:ObjectProperty , linkml:SlotDefinition ;
	rdfs:label "shot_type" ;
	rdfs:range linkml:String ;
	skos:definition "E.g., CloseUp, MediumShot, WideShot" ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:species a owl:ObjectProperty , linkml:SlotDefinition ;
	rdfs:label "species" ;
	rdfs:range linkml:String ;
	skos:definition "What kind of creature this is (e.g. 'horse', 'bird', 'reindeer')." ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:target_lora_tag a owl:ObjectProperty , linkml:SlotDefinition ;
	rdfs:label "target_lora_tag" ;
	rdfs:range linkml:String ;
	skos:definition "The exact trigger string that activates your trained Qwen LoRA." ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:time_of_day a owl:ObjectProperty , linkml:SlotDefinition ;
	rdfs:label "time_of_day" ;
	rdfs:range linkml:String ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:visual_attributes a owl:ObjectProperty , linkml:SlotDefinition ;
	rdfs:label "visual_attributes" ;
	rdfs:range ex:VisualAttribute ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:visual_composition a owl:ObjectProperty , linkml:SlotDefinition ;
	rdfs:label "visual_composition" ;
	rdfs:range ex:VisualComposition ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
<https://w3id.org/grej/prompt-governance-ontology> a owl:Ontology ;
	rdfs:label "prompt_governance_ontology" ;
	skos:definition "LinkML schema governing narrative semantics, visual composition, and LoRA image generation constraints." .
_:c14n0 a owl:Restriction ;
	owl:maxCardinality 1 ;
	owl:onProperty ex:camera_angle .
_:c14n1 a owl:Restriction ;
	owl:maxCardinality 1 ;
	owl:onProperty ex:current_location .
_:c14n10 rdf:first ex:Character ;
	rdf:rest _:c14n14 .
_:c14n11 a owl:AllDisjointClasses ;
	owl:members _:c14n10 .
_:c14n12 rdf:first ex:Prop ;
	rdf:rest _:c14n17 .
_:c14n13 a owl:Restriction ;
	owl:maxCardinality 1 ;
	owl:onProperty ex:current_location .
_:c14n14 rdf:first ex:Creature ;
	rdf:rest _:c14n12 .
_:c14n15 a owl:Restriction ;
	owl:maxCardinality 1 ;
	owl:onProperty ex:time_of_day .
_:c14n16 a owl:Restriction ;
	owl:maxCardinality 1 ;
	owl:onProperty ex:current_state .
_:c14n17 rdf:first ex:Setting ;
	rdf:rest rdf:nil .
_:c14n18 a owl:Restriction ;
	owl:maxCardinality 1 ;
	owl:onProperty ex:description .
_:c14n19 a owl:Restriction ;
	owl:maxCardinality 1 ;
	owl:onProperty ex:target_lora_tag .
_:c14n2 a owl:Restriction ;
	owl:maxCardinality 1 ;
	owl:onProperty ex:carried_by .
_:c14n20 a owl:Restriction ;
	owl:cardinality 1 ;
	owl:onProperty ex:prompt_id .
_:c14n21 a owl:Restriction ;
	owl:maxCardinality 1 ;
	owl:onProperty ex:species .
_:c14n22 a owl:Restriction ;
	owl:maxCardinality 1 ;
	owl:onProperty ex:focal_subject .
_:c14n23 a owl:Restriction ;
	owl:maxCardinality 1 ;
	owl:onProperty ex:current_state .
_:c14n24 a owl:Restriction ;
	owl:maxCardinality 1 ;
	owl:onProperty ex:shot_type .
_:c14n25 a owl:Restriction ;
	owl:cardinality 1 ;
	owl:onProperty ex:entity_name .
_:c14n3 a owl:Restriction ;
	owl:maxCardinality 1 ;
	owl:onProperty ex:canonical_outfit .
_:c14n4 a owl:Restriction ;
	owl:maxCardinality 1 ;
	owl:onProperty ex:lora_activator .
_:c14n5 a owl:Restriction ;
	owl:maxCardinality 1 ;
	owl:onProperty ex:environmental_conditions .
_:c14n6 a owl:Restriction ;
	owl:maxCardinality 1 ;
	owl:onProperty ex:visual_attributes .
_:c14n7 a owl:Restriction ;
	owl:maxCardinality 1 ;
	owl:onProperty ex:visual_composition .
_:c14n8 a owl:Restriction ;
	owl:maxCardinality 1 ;
	owl:onProperty ex:lighting_style .
_:c14n9 a owl:Restriction ;
	owl:maxCardinality 1 ;
	owl:onProperty ex:color_palette .

