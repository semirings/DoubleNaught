@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <https://example.org/prompt-guard#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
ex:Character a owl:Class ;
	rdfs:label "Character" ;
	rdfs:subClassOf ex:NarrativeEntity , _:c14n12 , _:c14n17 , _:c14n25 , _:c14n32 , _:c14n39 , _:c14n4 , _:c14n40 , _:c14n49 , _:c14n57 ;
	skos:definition "An actor or person within the narrative universe." ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:NarrativeEntity a owl:Class ;
	rdfs:label "NarrativeEntity" ;
	rdfs:subClassOf _:c14n36 , _:c14n44 , _:c14n48 , _:c14n55 , _:c14n56 , _:c14n6 ;
	skos:definition "Base class for all persistent story world elements." ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:PromptSpecification a owl:Class ;
	rdfs:label "PromptSpecification" ;
	rdfs:subClassOf _:c14n13 , _:c14n15 , _:c14n16 , _:c14n18 , _:c14n21 , _:c14n22 , _:c14n26 , _:c14n3 , _:c14n31 , _:c14n33 , _:c14n38 , _:c14n42 , _:c14n58 , _:c14n7 ;
	skos:definition "The top-level structured prompt payload validated by the matrix layer before generation." ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:Prop a owl:Class ;
	rdfs:label "Prop" ;
	rdfs:subClassOf ex:NarrativeEntity , _:c14n27 , _:c14n8 , _:c14n9 ;
	skos:definition "Key physical objects or items handled or present in the scene." ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:Setting a owl:Class ;
	rdfs:label "Setting" ;
	rdfs:subClassOf ex:NarrativeEntity , _:c14n1 , _:c14n14 , _:c14n19 , _:c14n23 , _:c14n35 , _:c14n41 ;
	skos:definition "A location or environmental backdrop." ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:VisualAttribute a owl:Class ;
	rdfs:label "VisualAttribute" ;
	rdfs:subClassOf _:c14n11 , _:c14n2 , _:c14n24 , _:c14n28 , _:c14n45 , _:c14n46 , _:c14n52 , _:c14n53 , _:c14n54 ;
	skos:definition "Governs aesthetic texture, lighting, and style tokens." ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:VisualComposition a owl:Class ;
	rdfs:label "VisualComposition" ;
	rdfs:subClassOf _:c14n0 , _:c14n10 , _:c14n20 , _:c14n30 , _:c14n47 , _:c14n5 , _:c14n50 , _:c14n51 , _:c14n59 ;
	skos:definition "Governs camera framing, perspective, and spatial layout." ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:camera_angle a owl:DatatypeProperty ;
	rdfs:label "camera_angle" ;
	rdfs:range xsd:string ;
	skos:definition "E.g., EyeLevel, LowAngle, BirdEye" ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:canonical_outfit a owl:DatatypeProperty ;
	rdfs:label "canonical_outfit" ;
	rdfs:range xsd:string ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:carried_by a owl:ObjectProperty ;
	rdfs:label "carried_by" ;
	rdfs:range ex:Character ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:color_palette a owl:DatatypeProperty ;
	rdfs:label "color_palette" ;
	rdfs:range xsd:string ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:current_location a owl:ObjectProperty ;
	rdfs:label "current_location" ;
	rdfs:range ex:Setting ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:current_state a owl:DatatypeProperty ;
	rdfs:label "current_state" ;
	rdfs:range xsd:string ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:description a owl:DatatypeProperty ;
	rdfs:label "description" ;
	rdfs:range xsd:string ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:entity_name a owl:DatatypeProperty ;
	rdfs:label "entity_name" ;
	rdfs:range xsd:string ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:environmental_conditions a owl:DatatypeProperty ;
	rdfs:label "environmental_conditions" ;
	rdfs:range xsd:string ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:focal_subject a owl:ObjectProperty ;
	rdfs:label "focal_subject" ;
	rdfs:range ex:NarrativeEntity ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:lighting_style a owl:DatatypeProperty ;
	rdfs:label "lighting_style" ;
	rdfs:range xsd:string ;
	skos:definition "E.g., CinematicStudio, Chiaroscuro, NaturalDaylight" ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:lora_activator a owl:DatatypeProperty ;
	rdfs:label "lora_activator" ;
	rdfs:range xsd:string ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:narrative_elements a owl:ObjectProperty ;
	rdfs:label "narrative_elements" ;
	rdfs:range ex:NarrativeEntity ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:prompt_id a owl:DatatypeProperty ;
	rdfs:label "prompt_id" ;
	rdfs:range xsd:string ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:shot_type a owl:DatatypeProperty ;
	rdfs:label "shot_type" ;
	rdfs:range xsd:string ;
	skos:definition "E.g., CloseUp, MediumShot, WideShot" ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:target_lora_tag a owl:DatatypeProperty ;
	rdfs:label "target_lora_tag" ;
	rdfs:range xsd:string ;
	skos:definition "The exact trigger string that activates your trained Qwen LoRA." ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:time_of_day a owl:DatatypeProperty ;
	rdfs:label "time_of_day" ;
	rdfs:range xsd:string ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:visual_attributes a owl:ObjectProperty ;
	rdfs:label "visual_attributes" ;
	rdfs:range ex:VisualAttribute ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
ex:visual_composition a owl:ObjectProperty ;
	rdfs:label "visual_composition" ;
	rdfs:range ex:VisualComposition ;
	skos:inScheme <https://w3id.org/grej/prompt-governance-ontology> .
<https://w3id.org/grej/prompt-governance-ontology.owl.ttl> a owl:Ontology ;
	rdfs:label "prompt_governance_ontology" ;
	skos:definition "LinkML schema governing narrative semantics, visual composition, and LoRA image generation constraints." .
